{
  "openapi": "3.0.3",
  "info": {
    "title": "RAGFlow Memory Management API",
    "description": "API OpenAPI Schema untuk pengelolaan Memory dan Message pada RAGFlow v0.26.4.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://ai-knowledge.mytens.id",
      "description": "Production Server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/memories": {
      "get": {
        "summary": "List Memory",
        "description": "Mengambil daftar memory yang tersedia beserta tipe, nama, dan tenant ID.",
        "operationId": "listMemory",
        "tags": [
          "Memory Management"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mengambil daftar memory.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMemoryResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "total": 1,
                    "memory_list": [
                      {
                        "id": "d6775d4eeada11f08ca284ba59bc53c7",
                        "name": "new_memory_1",
                        "tenant_id": "55777efac9df11f09cd07f49b",
                        "memory_type": [
                          "raw",
                          "semantic"
                        ],
                        "owner_name": "Lynn",
                        "permissions": "me",
                        "storage_type": "table",
                        "description": null,
                        "avatar": null,
                        "create_date": "Tue, 06 Jan 2026 16:36:00 GMT",
                        "create_time": 1767688607040
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages": {
      "post": {
        "summary": "Add Message",
        "description": "Menambahkan pesan baru ke dalam memory tertentu.",
        "operationId": "addMessage",
        "tags": [
          "Memory Management"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMessageRequest"
              },
              "example": {
                "memory_id": "d6775d4eeada11f08ca284ba59bc53c7",
                "role": "user",
                "content": "Pineapples are delicious fruits rich in vitamins.",
                "message_type": "semantic"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pesan berhasil ditambahkan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageDetailResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "id": "6c8983badede11f083f100163e000001",
                    "agent_id": "8db9c8eddfcc11f083f100163e000001",
                    "session_id": "bf0a50abeb811f083f100163e000001",
                    "memory_id": "d6775d4eeada11f08ca284ba59bc53c7",
                    "message_id": 270,
                    "message_type": "semantic",
                    "content": "Pineapples are delicious fruits rich in vitamins.",
                    "content_embed": [
                      0.03641991,
                      -0.012345,
                      0.087654
                    ],
                    "invalid_at": null,
                    "forget_at": null
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/search": {
      "get": {
        "summary": "Search Message",
        "description": "Melakukan pencarian pesan dalam memory berdasarkan query dan preferensi kesamaan (similarity threshold & keyword weight).",
        "operationId": "searchMessage",
        "tags": [
          "Memory Management"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Kata kunci atau teks pertanyaan untuk dicari.",
            "schema": {
              "type": "string"
            },
            "example": "pineapples"
          },
          {
            "name": "memory_id",
            "in": "query",
            "required": true,
            "description": "ID unik memory target.",
            "schema": {
              "type": "string"
            },
            "example": "d6775d4eeada11f08ca284ba59bc53c7"
          },
          {
            "name": "similarity_threshold",
            "in": "query",
            "required": false,
            "description": "Ambang batas kemiripan Vektor/Semantic (0.0 - 1.0).",
            "schema": {
              "type": "number",
              "default": 0.2
            },
            "example": 0.2
          },
          {
            "name": "keywords_similarity_weight",
            "in": "query",
            "required": false,
            "description": "Bobot pencarian kata kunci dibanding vektor.",
            "schema": {
              "type": "number",
              "default": 0.7
            },
            "example": 0.7
          },
          {
            "name": "top_n",
            "in": "query",
            "required": false,
            "description": "Jumlah maksimal pesan hasil pencarian.",
            "schema": {
              "type": "integer",
              "default": 6
            },
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Hasil pencarian pesan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchMessageResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "messages": [
                      {
                        "id": "6c8983badede11f083f100163e000001",
                        "message_id": 270,
                        "content": "Pineapples are delicious fruits rich in vitamins.",
                        "score": 0.92,
                        "message_type": "semantic"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/forget": {
      "post": {
        "summary": "Forget Message",
        "description": "Tandai atau hapus daftar pesan berdasarkan list message_id.",
        "operationId": "forgetMessage",
        "tags": [
          "Memory Management"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgetMessageRequest"
              },
              "example": {
                "memory_id": "d6775d4eeada11f08ca284ba59bc53c7",
                "message_ids": [270]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pesan berhasil ditandai/dihapus dari ingatan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgetMessageResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API_KEY"
      }
    },
    "schemas": {
      "ListMemoryResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "memory_list": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MemoryItem"
                }
              }
            }
          }
        }
      },
      "MemoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "memory_type": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_name": {
            "type": "string",
            "nullable": true
          },
          "permissions": {
            "type": "string",
            "nullable": true
          },
          "storage_type": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "create_date": {
            "type": "string"
          },
          "create_time": {
            "type": "integer"
          }
        }
      },
      "AddMessageRequest": {
        "type": "object",
        "required": [
          "memory_id",
          "content"
        ],
        "properties": {
          "memory_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "default": "user"
          },
          "content": {
            "type": "string"
          },
          "message_type": {
            "type": "string",
            "enum": [
              "semantic",
              "keyword"
            ],
            "default": "semantic"
          }
        }
      },
      "ForgetMessageRequest": {
        "type": "object",
        "required": [
          "memory_id",
          "message_ids"
        ],
        "properties": {
          "memory_id": {
            "type": "string"
          },
          "message_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "ForgetMessageResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "boolean"
          }
        }
      },
      "SearchMessageResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "message_id": {
                      "type": "integer"
                    },
                    "content": {
                      "type": "string"
                    },
                    "score": {
                      "type": "number"
                    },
                    "message_type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageDetailResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "agent_id": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "memory_id": {
                "type": "string"
              },
              "message_id": {
                "type": "integer"
              },
              "message_type": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "content_embed": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "nullable": true
              },
              "invalid_at": {
                "type": "string",
                "nullable": true
              },
              "forget_at": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
