{
  "openapi": "3.0.3",
  "info": {
    "title": "Squash TM REST API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://squash-dev.telkomdigital.id/squash/api/rest/latest"
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List all Squash TM projects",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
