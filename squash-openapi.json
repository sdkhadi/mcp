{
  "openapi": "3.0.3",
  "info": {
    "title": "Squash TM REST API - Curated Subset with Sample Payloads",
    "version": "4.1.0",
    "description": "OpenAPI specification for Campaigns, Folders, Iterations, Projects, Test Cases, Steps, Test Suites, and Test Plan associations with example payloads."
  },
  "servers": [
    {
      "url": "https://squash-dev.telkomdigital.id/squash/api/rest/latest"
    }
  ],
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "example": {
          "name": "Project Alpha",
          "description": "Sample project for integration testing"
        }
      },
      "Campaign": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reference": { "type": "string" }
        },
        "example": {
          "name": "Regression Cycle 1",
          "description": "Monthly regression testing campaign",
          "reference": "REG-01"
        }
      },
      "CampaignFolder": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "parentId": { "type": "integer" }
        },
        "example": {
          "name": "Sprint Folders",
          "parentId": 12
        }
      },
      "Iteration": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reference": { "type": "string" },
          "scheduledStartDate": { "type": "string", "format": "date" },
          "scheduledEndDate": { "type": "string", "format": "date" }
        },
        "example": {
          "name": "Iteration 1",
          "description": "First test cycle iteration",
          "reference": "IT-01",
          "scheduledStartDate": "2026-06-01",
          "scheduledEndDate": "2026-06-15"
        }
      },
      "TestCase": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "reference": { "type": "string" },
          "description": { "type": "string" },
          "importance": { "type": "string" },
          "status": { "type": "string" }
        },
        "example": {
          "name": "Login with valid credentials",
          "reference": "TC-LOGIN-01",
          "description": "Verify user can login using correct username and password",
          "importance": "HIGH",
          "status": "APPROVED"
        }
      },
      "TestCaseFolder": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "parentId": { "type": "integer" }
        },
        "example": {
          "name": "Authentication Tests",
          "parentId": 5
        }
      },
      "TestStep": {
        "type": "object",
        "properties": {
          "_type": { "type": "string", "example": "action-step" },
          "action": { "type": "string" },
          "expectedResult": { "type": "string" }
        },
        "example": {
          "_type": "action-step",
          "action": "Input username and password",
          "expectedResult": "Dashboard page is shown"
        }
      },
      "TestSueite": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "example": {
          "name": "Smoke Test Suite",
          "description": "Critical path test cases"
        }
      },
      "IterationTestPlanItem": {
        "type": "object",
        "properties": {
          "_type": { "type": "string", "example": "iteration-test-plan-item" },
          "test_case_id": { "type": "integer" }
        },
        "example": {
          "_type": "iteration-test-plan-item",
          "test_case_id": 90
        }
      },
      "TestPlanAssociation": {
        "type": "object",
        "properties": {
          "item_ids": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "example": {
          "item_ids": [80, 81, 82]
        }
      }
    }
  },
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "summary": "Get all projects",
        "responses": {
          "200": { "description": "Successful operation" }
        }
      },
      "post": {
        "summary": "Create project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Project" }
            }
          }
        },
        "responses": {
          "201": { "description": "Project created" }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "summary": "Get project by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
